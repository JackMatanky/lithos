#!/usr/bin/env bash
#
# watch — Watch for changes and automatically run tests.
#
#MISE description="Watch for changes and automatically run tests"
#MISE alias="tw"
#MISE sources=["**/*.rs", "Cargo.toml"]
#USAGE arg "[args]..." help="Arguments to pass to cargo test"

set -euo pipefail

#######################################
# Build the command string for cargo-watch.
# Globals:
#   usage_args
# Outputs:
#   Echoes the watch command
#######################################
build_watch_command() {
  if [[ -n "${usage_args:-}" ]]; then
    echo "test -- ${usage_args}"
  else
    echo "test"
  fi
}

#######################################
# Watch for changes and run tests using cargo-watch.
# Arguments:
#   $1 - The watch command string
# Outputs:
#   Writes test results to stdout on every change
#######################################
run_cargo_watch() {
  local watch_cmd="$1"
  echo "👀 Watching for changes..."
  cargo watch -x "${watch_cmd}"
}

#######################################
# Main entry point.
#######################################
main() {
  local watch_cmd
  watch_cmd="$(build_watch_command)"
  run_cargo_watch "${watch_cmd}"
}

main "$@"
