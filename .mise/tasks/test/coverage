#!/usr/bin/env bash
#MISE description="Generate code coverage reports using tarpaulin"
#MISE alias="tc"
#MISE depends=["fmt", "build"]
#MISE sources=["**/*.rs", "Cargo.toml"]
#MISE outputs=["{{vars.coverage_report}}"]
#MISE env={TARGET_DIR="{{vars.target_dir}}", COVERAGE_REPORT="{{vars.coverage_report}}"}
#USAGE flag "-o --open" help="Open coverage report in browser"
#USAGE flag "-p --package <package>" help="Run coverage for a specific package or module" {
#USAGE   choices "core" "cli" "config" "note" "schema" "template" "db" "fs"
#USAGE }

#######################################
# Map shorthand package names to full cargo package names.
# Globals:
#   usage_package
# Arguments:
#   None
# Outputs:
#   Echoes the full package name
#######################################
map_package_name() {
    case "${usage_package:-}" in
    core | config | note | schema | template | db | fs)
        # Modules live inside lithos-core
        echo "lithos-core"
        ;;
    cli)
        echo "lithos"
        ;;
    *)
        echo ""
        ;;
    esac
}

#######################################
# Build test filter for module-specific coverage.
# Globals:
#   usage_package
# Arguments:
#   None
# Outputs:
#   Echoes the test filter or empty string
#######################################
build_module_filter() {
    case "${usage_package:-}" in
    config | note | schema | template | db | fs)
        echo "${usage_package}::"
        ;;
    *)
        echo ""
        ;;
    esac
}



#######################################
# Build tarpaulin args based on package selection.
# Arguments:
#   Reference to an array for arguments
#   The resolved package name
# Outputs:
#   None
#######################################
build_tarpaulin_args() {
    local -n _tarpaulin_ref_args=$1
    local package_name=$2

    if [[ -n "${package_name}" ]]; then
        _tarpaulin_ref_args+=("--packages" "${package_name}")
    else
        _tarpaulin_ref_args+=("--workspace")
    fi
}

#######################################
# Generate code coverage report using tarpaulin.
# Arguments:
#   None
# Outputs:
#   Writes coverage report to stdout
#######################################
run_tarpaulin() {
    echo "📊 Generating code coverage report..."
    local output_dir="${TARGET_DIR}/tarpaulin"
    mkdir -p "${output_dir}"

    local resolved_package
    resolved_package=$(map_package_name)

    local tarpaulin_args=("--ignore-tests" "--out" "Html" "--output-dir" "${output_dir}")
    build_tarpaulin_args tarpaulin_args "${resolved_package}"

    local test_args=()
    local module_filter
    module_filter=$(build_module_filter)

    if [[ "${usage_skip_e2e:-}" == "1" ]]; then
        test_args=("--" "--skip" "cli_smoke" "--skip" "purity")
    elif [[ -n "${module_filter}" ]]; then
        test_args=("--" "${module_filter}")
    fi

    if [[ ${#test_args[@]} -gt 0 ]]; then
        cargo tarpaulin "${tarpaulin_args[@]}" "${test_args[@]}"
    else
        cargo tarpaulin "${tarpaulin_args[@]}"
    fi
}

#######################################
# Handle opening the report if requested.
# Globals:
#   usage_open
#   TARGET_DIR
#   COVERAGE_REPORT
# Arguments:
#   None
# Outputs:
#   None
#######################################
open_report() {
    if [[ "${usage_open:-}" == "1" ]]; then
        echo "🌐 Opening coverage report..."
        open_file "${TARGET_DIR}/tarpaulin/${COVERAGE_REPORT}"
    fi
}

#######################################
# Main entry point.
# Globals:
#   None
# Arguments:
#   $@
# Outputs:
#   None
#######################################
main() {
    run_tarpaulin
    open_report
    echo "✅ Coverage report generated"
}

main "$@"
