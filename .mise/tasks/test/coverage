#!/usr/bin/env bash
#MISE description="Generate code coverage reports using tarpaulin"
#MISE alias="tc"
#MISE depends=["fmt", "build"]
#MISE sources=["**/*.rs", "Cargo.toml"]
#MISE outputs=["{{vars.coverage_report}}"]
#MISE env={TARGET_DIR="{{vars.target_dir}}", COVERAGE_REPORT="{{vars.coverage_report}}"}
#USAGE flag "-o --open" help="Open coverage report in browser"
#USAGE flag "-p --package <package>" help="Run coverage for a specific package or module" {
#USAGE   choices "core" "cli" "config" "note" "schema" "template" "db" "fs"
#USAGE }
#USAGE flag "--skip-e2e" help="Skip E2E tests (when coverage tooling cannot build CLI binaries)"

#######################################
# Map shorthand package names to full cargo package names.
# Globals:
#   usage_package
# Arguments:
#   None
# Outputs:
#   Echoes the full package name
#######################################
map_package_name() {
    case "${usage_package:-}" in
    core | config | note | schema | template | db | fs)
        # Modules live inside lithos-core
        echo "lithos-core"
        ;;
    cli)
        echo "lithos"
        ;;
    *)
        echo ""
        ;;
    esac
}

#######################################
# Build base tarpaulin arguments (output format and directory).
# Globals:
#   TARGET_DIR (from env)
# Arguments:
#   Reference to an array for arguments
# Outputs:
#   None
#######################################
build_tarpaulin_base_args() {
    local -n _base_ref_args=$1
    local output_dir="${TARGET_DIR}/tarpaulin"

    mkdir -p "${output_dir}"

    _base_ref_args+=("--ignore-tests")
    _base_ref_args+=("--out" "Html")
    _base_ref_args+=("--output-dir" "${output_dir}")
}

#######################################
# Add package selection to tarpaulin args.
# Arguments:
#   Reference to an array for arguments
#   The resolved package name
# Outputs:
#   None
#######################################
add_package_selection() {
    local -n _pkg_ref_args=$1
    local package_name=$2

    if [[ -n "${package_name}" ]]; then
        _pkg_ref_args+=("--packages" "${package_name}")
    else
        _pkg_ref_args+=("--workspace")
    fi
}

#######################################
# Build test filter arguments for tarpaulin.
# Globals:
#   usage_package
#   usage_skip_e2e
# Arguments:
#   Reference to an array for arguments
# Outputs:
#   None
#######################################
build_test_filter_args() {
    local -n _filter_ref_args=$1

    # Handle --skip-e2e flag
    if [[ "${usage_skip_e2e:-}" == "1" ]]; then
        _filter_ref_args+=("--" "--skip" "cli_smoke")
        return
    fi

    # Handle module-specific filtering
    case "${usage_package:-}" in
    config | note | schema | template | db | fs)
        _filter_ref_args+=("--" "${usage_package}::")
        ;;
    esac
}

#######################################
# Generate code coverage report using tarpaulin.
# Arguments:
#   Arguments for cargo tarpaulin (array elements)
# Outputs:
#   Writes coverage report to stdout
#######################################
run_tarpaulin() {
    echo "📊 Generating code coverage report..."
    cargo tarpaulin "$@"
}

#######################################
# Handle opening the report if requested.
# Globals:
#   usage_open
#   TARGET_DIR
#   COVERAGE_REPORT
# Arguments:
#   None
# Outputs:
#   None
#######################################
open_report() {
    if [[ "${usage_open:-}" == "1" ]]; then
        echo "🌐 Opening coverage report..."
        open_file "${TARGET_DIR}/tarpaulin/${COVERAGE_REPORT}"
    fi
}

#######################################
# Main entry point.
# Globals:
#   usage_package
#   usage_skip_e2e
#   usage_open
# Arguments:
#   $@
# Outputs:
#   None
#######################################
main() {
    local resolved_package
    resolved_package=$(map_package_name)

    # Build tarpaulin arguments
    local tarpaulin_args=()
    build_tarpaulin_base_args tarpaulin_args
    add_package_selection tarpaulin_args "${resolved_package}"
    build_test_filter_args tarpaulin_args

    # Run coverage
    run_tarpaulin "${tarpaulin_args[@]}"

    # Open report if requested
    open_report

    echo "✅ Coverage report generated"
}

main "$@"
