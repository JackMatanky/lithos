#!/usr/bin/env bash
#MISE description="Run all integration tests across the workspace using nextest"
#MISE alias="ti"
#MISE depends=["fmt"]
#MISE sources=["**/*.rs", "Cargo.toml", "rustfmt.toml", "rust-toolchain.toml"]
#MISE outputs=["{{vars.nextest_dir}}/default"]
#MISE env={RUST_BACKTRACE="1"}
#USAGE flag "-v --verbose" help="Verbose output"
#USAGE arg "[filter]" help="Filter tests by name"

set -euo pipefail

#######################################
# Build arguments for nextest integration tests.
# Globals:
#   usage_verbose
#   usage_filter
#   TEST_THREADS (from env)
#   RUST_BACKTRACE (set by #MISE env directive)
# Arguments:
#   Reference to an array for arguments
# Outputs:
#   None
#######################################
build_test_args() {
    local -n ref_args=$1

    # Parallel execution control matching mise.toml configuration
    # Use TEST_THREADS from environment (set by mise.toml env section)
    ref_args+=("--test-threads" "${TEST_THREADS:-4}")

    # Run all workspace tests
    ref_args+=("--workspace")

    # Nextest partitioning for consistent test distribution
    ref_args+=("--partition" "hash:1/1")

    # Note: JUnit output requires nextest profile configuration in .config/nextest.toml
    # The --junit flag does not exist in nextest 0.9.x - removed for compatibility

    if [[ "${usage_verbose:-}" == "1" ]]; then
        ref_args+=("--verbose")
    fi

    # Test filter (if specified)
    if [[ -n "${usage_filter:-}" ]]; then
        ref_args+=("${usage_filter}")
    fi
}

#######################################
# Execute integration tests using nextest.
# Arguments:
#   Arguments for cargo nextest run
# Outputs:
#   Writes test results to stdout
#######################################
run_nextest() {
    echo "🧪 Running integration tests..."
    cargo nextest run "$@"
}

#######################################
# Main entry point.
# Globals:
#   RUST_BACKTRACE (set by #MISE env directive)
# Arguments:
#   $@
# Outputs:
#   None
#######################################
main() {
    local args=()
    build_test_args args
    run_nextest "${args[@]}"
    echo "✅ Integration tests complete"
}

main "$@"
