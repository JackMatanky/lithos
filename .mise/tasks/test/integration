#!/usr/bin/env bash
#
# integration — Run integration tests across the workspace using nextest.
#
#MISE description="Run all integration tests across the workspace using nextest"
#MISE alias="ti"
#MISE depends=["fmt", "build"]
#MISE sources=["**/*.rs", "Cargo.toml", "rustfmt.toml", "rust-toolchain.toml"]
#MISE env={RUST_BACKTRACE="1"}
#USAGE flag "-v --verbose" help="Verbose output"
#USAGE flag "-p --package <package>" help="Run tests for a specific crate" {
#USAGE   choices "cli" "settings" "note" "schema" "template" "db" "fs" "app" "support" "indexer" "vault" "utils"
#USAGE }
#USAGE arg "[filter]" help="Filter tests by name"

set -euo pipefail

# shellcheck disable=SC1091
source "$(git rev-parse --show-toplevel)/.mise/lib/_crate_names.sh"

#######################################
# Main entry point.
# Globals:
#   TEST_THREADS   (read)
#   usage_verbose  (read)
#   usage_filter   (read)
#   usage_package  (read)
#######################################
main() {
  local -a args=()

  # Threading
  args+=("--test-threads" "${TEST_THREADS:-4}")

  # Package selection
  if [[ -n "${usage_package:-}" ]]; then
    local resolved
    resolved="$(resolve_crate_name "${usage_package}")"
    if [[ -z "${resolved}" ]]; then
      echo "Error: Unknown crate '${usage_package}'" >&2
      exit 1
    fi
    args+=("--package" "${resolved}")
  else
    args+=("--workspace")
  fi

  # Integration tests only
  args+=("--filter-expr" "kind(test)")
  if [[ -n "${usage_filter:-}" ]]; then
    args+=("${usage_filter}")
  fi

  # Execution options
  args+=("--partition" "hash:1/1")
  args+=("--no-tests" "pass")
  if [[ "${usage_verbose:-}" == "1" ]]; then
    args+=("--verbose")
  fi

  echo "🧪 Running integration tests..."
  cargo nextest run "${args[@]}"
  echo "✅ Integration tests complete"
}

main "$@"
