#!/usr/bin/env bash
#MISE description="Run all unit tests across the workspace using nextest"
#MISE alias="tu"
#MISE depends=["fmt"]
#MISE sources=["**/*.rs", "Cargo.toml", "rustfmt.toml", "rust-toolchain.toml"]
#MISE env={RUST_BACKTRACE="1"}
#USAGE flag "-v --verbose" help="Verbose output"
#USAGE flag "-p --package <package>" help="Run tests for a specific package or module" {
#USAGE   choices "core" "cli" "config" "note" "schema" "template" "db" "fs"
#USAGE }
#USAGE arg "[filter]" help="Filter tests by name"

set -euo pipefail

#######################################
# Map shorthand package names to full cargo package names.
# Globals:
#   usage_package
# Arguments:
#   None
# Outputs:
#   Echoes the full package name
#######################################
map_package_name() {
    case "${usage_package:-}" in
    core | config | note | schema | template | db | fs)
        # Modules live inside lithos-core
        echo "lithos-core"
        ;;
    cli)
        echo "lithos"
        ;;
    *)
        # Empty string for workspace-wide or unrecognized
        echo ""
        ;;
    esac
}

#######################################
# If the user selects a bounded context and does not pass a filter, provide a
# sensible default filter that narrows tests to that module.
#
# Globals:
#   usage_package
#   usage_filter
# Arguments:
#   None
# Outputs:
#   Updates usage_filter in-place
#######################################
context_filter() {
    if [[ -n "${usage_filter:-}" ]]; then
        return
    fi

    case "${usage_package:-}" in
    config | note | schema | template | db | fs)
        usage_filter="${usage_package}::"
        ;;
    *)
        ;;
    esac
}

#######################################
# Build nextest or doc-test arguments into a named global array.
# Globals:
#   usage_package   (read)
#   usage_verbose   (read)
#   usage_filter    (read)
# Arguments:
#   $1 - The resolved package name
#   $2 - The test runner type ("nextest" or "doc")
#######################################
NEXTEST_ARGS=()
DOC_ARGS=()

build_test_args() {
    local package_name=$1
    local test_type=$2
    local -a args=()

    # Nextest-specific arguments
    if [[ "${test_type}" == "nextest" ]]; then
        if [[ "${usage_package:-}" == "cli" ]]; then
            args+=("--bins")
        else
            args+=("--lib" "--bins")
        fi
        args+=("--partition" "hash:1/1")
        if [[ "${usage_verbose:-}" == "1" ]]; then
            args+=("--verbose")
        fi
    fi

    # Package selection
    if [[ -n "${package_name}" ]]; then
        args+=("--package" "${package_name}")
    else
        args+=("--workspace")
    fi

    # Optional name filter
    if [[ -n "${usage_filter:-}" ]]; then
        args+=("${usage_filter}")
    fi

    # Store into the appropriate global array
    if [[ "${test_type}" == "nextest" ]]; then
        NEXTEST_ARGS=("${args[@]}")
    else
        DOC_ARGS=("${args[@]}")
    fi
}

#######################################
# Main entry point.
# Globals:
#   usage_package  (read)
#######################################
main() {
    context_filter

    local resolved_package
    resolved_package=$(map_package_name)

    build_test_args "${resolved_package}" "nextest"
    build_test_args "${resolved_package}" "doc"

    echo "🧪 Running unit tests (nextest)..."
    cargo nextest run "${NEXTEST_ARGS[@]}"

    if [[ "${usage_package:-}" == "cli" ]]; then
        echo "📖 Skipping doc tests (binary-only package)..."
    else
        echo "📖 Running doc tests..."
        cargo test --doc "${DOC_ARGS[@]}"
    fi

    echo "✅ All unit and doc tests complete"
}

main "$@"
