#!/usr/bin/env bash
#MISE description="Run all unit tests across the workspace using nextest"
#MISE alias="tu"
#MISE depends=["fmt"]
#MISE sources=["**/*.rs", "Cargo.toml", "rustfmt.toml", "rust-toolchain.toml"]
#MISE outputs=["{{vars.nextest_dir}}/default"]
#MISE env={RUST_BACKTRACE="1"}
#USAGE flag "-v --verbose" help="Verbose output"
#USAGE flag "-p --package <package>" help="Run tests for a specific package" {
#USAGE   choices "domain" "app" "adapters" "cli" "test-utils"
#USAGE }
#USAGE arg "[filter]" help="Filter tests by name"

set -euo pipefail

#######################################
# Map shorthand package names to full cargo package names.
# Globals:
#   usage_package
# Arguments:
#   None
# Outputs:
#   Echoes the full package name
#######################################
map_package_name() {
    case "${usage_package:-}" in
    domain | app | adapters | test-utils | integration-tests)
        echo "lithos-${usage_package}"
        ;;
    cli)
        echo "lithos"
        ;;
    *)
        echo ""
        ;;
    esac
}

#######################################
# Add nextest specific arguments.
# Globals:
#   usage_verbose
#   usage_filter
# Arguments:
#   Reference to an array for arguments
# Outputs:
#   None
#######################################
add_nextest_args() {
    local -n _nextest_ref_args=$1

    _nextest_ref_args+=("--lib" "--bins")
    _nextest_ref_args+=("--partition" "hash:1/1")

    if [[ "${usage_verbose:-}" == "1" ]]; then
        _nextest_ref_args+=("--verbose")
    fi

    if [[ -n "${usage_filter:-}" ]]; then
        _nextest_ref_args+=("${usage_filter}")
    fi
}

#######################################
# Add package selection arguments.
# Arguments:
#   Reference to an array for arguments
#   The resolved package name
# Outputs:
#   None
#######################################
add_package_args() {
    local -n _pkg_ref_args=$1
    local package_name=$2

    if [[ -n "${package_name}" ]]; then
        _pkg_ref_args+=("--package" "${package_name}")
    else
        _pkg_ref_args+=("--workspace")
    fi
}

#######################################
# Build arguments for nextest unit tests.
# Globals:
#   RUST_BACKTRACE (set by #MISE env directive)
# Arguments:
#   Reference to an array for arguments
#   The resolved package name
#   The test runner type ("nextest" or "doc")
# Outputs:
#   None
#######################################
build_test_arg() {
    local -n _main_ref_args=$1
    local package_name=$2
    local test_type=$3

    # Core test arguments
    if [[ "${test_type}" == "nextest" ]]; then
        add_nextest_args _main_ref_args
    fi

    # Package selection (Common)
    add_package_args _main_ref_args "${package_name}"
}

#######################################
# Execute unit tests using nextest and doc tests using cargo.
# Arguments:
#   Arguments for cargo nextest run (array elements)
#   --- separator ---
#   Arguments for cargo test --doc (remaining array elements)
# Outputs:
#   Writes test results to stdout
#######################################
run_tests() {
    local nextest_args=()
    local doc_args=()
    local target="nextest"

    for arg in "$@"; do
        if [[ "${arg}" == "---" ]]; then
            target="doc"
            continue
        fi

        if [[ "${target}" == "nextest" ]]; then
            nextest_args+=("${arg}")
        else
            doc_args+=("${arg}")
        fi
    done

    echo "🧪 Running unit tests (nextest)..."
    cargo nextest run "${nextest_args[@]}"

    echo "📖 Running doc tests..."
    cargo test --doc "${doc_args[@]}"
}

#######################################
# Main entry point.
# Globals:
#   RUST_BACKTRACE (set by #MISE env directive)
# Arguments:
#   $@
# Outputs:
#   None
#######################################
main() {
    local resolved_package
    resolved_package=$(map_package_name)

    local nextest_args=()
    build_test_arg nextest_args "${resolved_package}" "nextest"

    local doc_args=()
    build_test_arg doc_args "${resolved_package}" "doc"

    run_tests "${nextest_args[@]}" "---" "${doc_args[@]}"
    echo "✅ All unit and doc tests complete"
}

main "$@"
