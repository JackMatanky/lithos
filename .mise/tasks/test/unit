#!/usr/bin/env bash
#MISE description="Run all unit tests across the workspace using nextest"
#MISE alias="tu"
#MISE depends=["fmt"]
#MISE sources=["**/*.rs", "Cargo.toml", "rustfmt.toml", "rust-toolchain.toml"]
#MISE outputs=["{{vars.nextest_dir}}/default"]
#MISE env={RUST_BACKTRACE="1"}
#USAGE flag "-v --verbose" help="Verbose output"
#USAGE flag "-p --package <package>" help="Run tests for a specific package" {
#USAGE   choices "domain" "app" "adapters" "cli" "test-utils"
#USAGE }
#USAGE arg "[filter]" help="Filter tests by name"

set -euo pipefail

#######################################
# Map shorthand package names to full cargo package names.
# Globals:
#   usage_package
# Arguments:
#   None
# Outputs:
#   Echoes the full package name
#######################################
map_package_name() {
    case "${usage_package:-}" in
    domain | app | adapters)
        echo "lithos-${usage_package}"
        ;;
    test-utils)
        echo "lithos-test-utils"
        ;;
    cli)
        echo "lithos"
        ;;
    *)
        echo ""
        ;;
    esac
}

#######################################
# Build arguments for nextest unit tests.
# Globals:
#   usage_verbose
#   usage_filter
#   RUST_BACKTRACE (set by #MISE env directive)
# Arguments:
#   Reference to an array for arguments
#   The resolved package name
# Outputs:
#   None
#######################################
build_test_args() {
    local -n ref_args=$1
    local package_name=$2

    # Core test arguments matching mise.toml configuration
    ref_args+=("--lib" "--bins")

    if [[ "${usage_verbose:-}" == "1" ]]; then
        ref_args+=("--verbose")
    fi

    # Package selection
    if [[ -n "${package_name}" ]]; then
        ref_args+=("--package" "${package_name}")
    else
        ref_args+=("--workspace")
    fi

    # Nextest partitioning for consistent test distribution
    ref_args+=("--partition" "hash:1/1")

    # Note: JUnit output requires nextest profile configuration in .config/nextest.toml
    # The --junit flag does not exist in nextest 0.9.x - removed for compatibility

    # Test filter (if specified)
    if [[ -n "${usage_filter:-}" ]]; then
        ref_args+=("${usage_filter}")
    fi
}

#######################################
# Execute unit tests using nextest.
# Arguments:
#   Arguments for cargo nextest run
# Outputs:
#   Writes test results to stdout
#######################################
run_nextest() {
    echo "🧪 Running unit tests..."
    cargo nextest run "$@"
}

#######################################
# Main entry point.
# Globals:
#   RUST_BACKTRACE (set by #MISE env directive)
# Arguments:
#   $@
# Outputs:
#   None
#######################################
main() {
    local resolved_package
    resolved_package=$(map_package_name)

    local args=()
    build_test_args args "${resolved_package}"

    run_nextest "${args[@]}"
    echo "✅ Unit tests complete"
}

main "$@"
