#!/usr/bin/env bash
#MISE description="Run architecture and boundary enforcement tests"
#MISE alias="ta"
#MISE depends=["fmt", "build"]
#MISE sources=["**/*.rs", "Cargo.toml"]
#MISE env={RUST_BACKTRACE="1"}
#USAGE flag "-v --verbose" help="Verbose output"
#USAGE arg "[filter]" help="Filter tests by name"

set -euo pipefail

#######################################
# Extract test names from Cargo.toml based on directory.
# Arguments:
#   dir: The directory within tests/suite (e.g., "arch")
# Outputs:
#   Echoes space-separated test names
#######################################
get_tests_by_dir() {
  local dir="$1"
  local manifest="tests/suite/Cargo.toml"

  if [[ ! -f "${manifest}" ]]; then
    return 1
  fi

  # Look for name and path in [[test]] blocks.
  grep -B 1 "path = \"${dir}/" "${manifest}" | grep "name =" | sed 's/name = "\(.*\)"/\1/'
}

#######################################
# Run architecture tests using nextest.
# Globals:
#   usage_verbose
#   usage_filter
# Arguments:
#   None
# Outputs:
#   Writes test results to stdout
#######################################
run_arch_tests() {
  local suite_dir="arch"
  local test_names
  test_names=$(get_tests_by_dir "${suite_dir}")

  if [[ -z "${test_names}" ]]; then
    echo "⚠️ No architecture tests found in ${suite_dir}"
    return 0
  fi

  local args=(
    "--package" "lithos-integration-tests"
  )

  for t in ${test_names}; do
    args+=("--test" "${t}")
  done

  if [[ "${usage_verbose:-}" == "1" ]]; then
    args+=("--verbose")
  fi

  if [[ -n "${usage_filter:-}" ]]; then
    args+=("${usage_filter}")
  fi

  echo "🏗️ Running architecture tests..."
  cargo nextest run "${args[@]}"
}

#######################################
# Main entry point.
# Arguments:
#   $@
# Outputs:
#   None
#######################################
main() {
  run_arch_tests
  echo "✅ Architecture tests complete"
}

main "$@"
