#!/usr/bin/env bash
#MISE description="Run performance benchmarks for all workspace crates, using criterion"
#MISE alias="tb"
#MISE sources=["**/*.rs", "Cargo.toml"]

set -euo pipefail

#######################################
# Run benchmarks for all crates.
# Arguments:
#   Arguments for cargo bench
# Outputs:
#   Writes benchmark results to stdout
#######################################
run_cargo_bench() {
    echo "🧪 Running benchmarks..."
    cargo bench "$@"
}

#######################################
# Main entry point.
# Globals:
#   None
# Arguments:
#   $@
# Outputs:
#   None
#######################################
main() {
    run_cargo_bench "$@"
    echo "✅ Benchmarking complete"
}

main "$@"
