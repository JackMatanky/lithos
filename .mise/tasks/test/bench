#!/usr/bin/env bash
#MISE description="Run performance benchmarks for workspace crates using criterion"
#MISE alias="tb"
#MISE sources=["**/*.rs", "Cargo.toml"]
#USAGE arg "[filter]" help="Filter benchmarks by name"
#USAGE flag "-p --package <package>" help="Run benchmarks for a specific package" {
#USAGE   choices "core" "lithos-core" "cli" "lithos"
#USAGE }

#######################################
# Map shorthand package names to full cargo package names.
# Globals:
#   usage_package
# Arguments:
#   None
# Outputs:
#   Echoes the full package name
#######################################
map_package_name() {
  case "${usage_package:-}" in
  core | lithos-core)
    echo "lithos-core"
    ;;
  cli | lithos)
    echo "lithos"
    ;;
  *)
    echo ""
    ;;
  esac
}

#######################################
# Build arguments for cargo bench.
# Globals:
#   usage_package
# Arguments:
#   Reference to an array for cargo arguments
#   The resolved package name
# Outputs:
#   None
#######################################
build_cargo_args() {
  local -n ref_cargo_args=$1
  local package_name=$2

  # We use --benches to target only explicit [[bench]] targets.
  # This prevents Criterion-specific flags from being passed to unit test runners.
  ref_cargo_args+=("--benches")

  if [[ -n "${package_name}" ]]; then
    ref_cargo_args+=("--package" "${package_name}")
  else
    ref_cargo_args+=("--workspace")
  fi
}

#######################################
# Build arguments for Criterion benchmarks.
# Globals:
#   usage_filter
#   usage_quick
#   usage_noplot
# Arguments:
#   Reference to an array for benchmark arguments
# Outputs:
#   None
#######################################
build_bench_args() {
  local -n ref_bench_args=$1

  if [[ -n "${usage_filter:-}" ]]; then
    ref_bench_args+=("${usage_filter}")
  fi

  if [[ "${usage_quick:-}" == "true" ]]; then
    ref_bench_args+=("--quick")
  fi

  if [[ "${usage_noplot:-}" == "true" ]]; then
    ref_bench_args+=("--noplot")
  fi
}

#######################################
# Run performance benchmarks using cargo bench.
# Arguments:
#   Cargo arguments array (reference)
#   Benchmark arguments array (reference)
# Outputs:
#   Writes benchmark progress to stdout
#######################################
run_benchmarks() {
  local -n cargo_args_ref=$1
  local -n bench_args_ref=$2

  echo "🧪 Running benchmarks..."

  # Correct syntax: cargo bench [cargo_args] [-- [bench_args]]
  # We use the double dash to separate cargo arguments from Criterion/bench arguments.
  if [[ ${#bench_args_ref[@]} -gt 0 ]]; then
    cargo bench "${cargo_args_ref[@]}" -- "${bench_args_ref[@]}"
  else
    cargo bench "${cargo_args_ref[@]}"
  fi
}

#######################################
# Main entry point for the benchmark task.
# Globals:
#   None
# Arguments:
#   None
# Outputs:
#   None
#######################################
main() {
  local resolved_package
  resolved_package=$(map_package_name)

  # Shellcheck SC2034: Variables are used via nameref in build/run functions
  # shellcheck disable=SC2034
  local cargo_args=()
  build_cargo_args cargo_args "${resolved_package}"

  # shellcheck disable=SC2034
  local bench_args=()
  build_bench_args bench_args

  run_benchmarks cargo_args bench_args

  echo "✅ Benchmarking complete"
}

main "$@"
