#!/usr/bin/env bash
#MISE description="Run end-to-end CLI tests"
#MISE alias="te"
#MISE depends=["build"]
#MISE sources=["**/*.rs", "Cargo.toml"]
#MISE env={RUST_BACKTRACE="1"}
#USAGE flag "-v --verbose" help="Verbose output"
#USAGE arg "[filter]" help="Filter tests by name"

set -euo pipefail

#######################################
# Extract test names from Cargo.toml based on directory.
# Arguments:
#   dir: The directory within tests/suite (e.g., "e2e")
# Outputs:
#   Echoes space-separated test names
#######################################
get_tests_by_dir() {
  local dir="$1"
  local manifest="tests/suite/Cargo.toml"

  if [[ ! -f "${manifest}" ]]; then
    return 1
  fi

  # Look for name and path in [[test]] blocks.
  grep -B 1 "path = \"${dir}/" "${manifest}" | grep "name =" | sed 's/name = "\(.*\)"/\1/'
}

#######################################
# Run E2E tests using nextest.
# Globals:
#   usage_verbose
#   usage_filter
#   TEST_THREADS
# Arguments:
#   None
# Outputs:
#   Writes test results to stdout
#######################################
run_e2e_tests() {
  local suite_dir="e2e"
  local test_names
  test_names=$(get_tests_by_dir "${suite_dir}")

  if [[ -z "${test_names}" ]]; then
    echo "⚠️ No E2E tests found in ${suite_dir}"
    return 0
  fi

  local args=(
    "--package" "lithos-integration-tests"
    "--test-threads" "${TEST_THREADS:-4}"
  )

  for t in ${test_names}; do
    args+=("--test" "${t}")
  done

  if [[ "${usage_verbose:-}" == "1" ]]; then
    args+=("--verbose")
  fi

  if [[ -n "${usage_filter:-}" ]]; then
    args+=("${usage_filter}")
  fi

  echo "🚀 Running E2E tests..."
  cargo nextest run "${args[@]}"
}

#######################################
# Main entry point.
# Arguments:
#   $@
# Outputs:
#   None
#######################################
main() {
  run_e2e_tests
  echo "✅ E2E tests complete"
}

main "$@"
