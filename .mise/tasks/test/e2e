#!/usr/bin/env bash
#MISE description="Run end-to-end (E2E) tests using nextest"
#MISE alias="te"
#MISE depends=["fmt", "build"]
#MISE sources=["{{vars.test_e2e_dir}}/**/*.rs", "Cargo.toml"]
#MISE env={RUST_BACKTRACE="1", TEST_E2E_DIR="{{vars.test_e2e_dir}}"}
#USAGE flag "-v --verbose" help="Verbose output"
#USAGE arg "[filter]" help="Filter tests by name"

set -euo pipefail

#######################################
# Add parallel execution control
# Globals:
#   TEST_THREADS (from env)
# Arguments:
#   Reference to an array for arguments
# Outputs:
#   None
#######################################
add_threading_args() {
    local -n _threading_ref_args=$1
    _threading_ref_args+=("--test-threads" "${TEST_THREADS:-4}")
}

#######################################
# Add nextest execution options
# Globals:
#   usage_verbose
# Arguments:
#   Reference to an array for arguments
# Outputs:
#   None
#######################################
add_execution_args() {
    local -n _exec_ref_args=$1
    _exec_ref_args+=("--partition" "hash:1/1")

    if [[ "${usage_verbose:-}" == "1" ]]; then
        _exec_ref_args+=("--verbose")
    fi
}

#######################################
# Add E2E specific filter arguments
# Globals:
#   usage_filter
# Arguments:
#   Reference to an array for arguments
# Outputs:
#   None
#######################################
add_filter_args() {
    local -n _filter_ref_args=$1

    # Target the CLI crate, which contains the smoke test.
    _filter_ref_args+=("--package" "lithos")

    # Filter for E2E/smoke tests based on binary name.
    _filter_ref_args+=("--filter-expr" "binary(lithos)")

    if [[ -n "${usage_filter:-}" ]]; then
        _filter_ref_args+=("${usage_filter}")
    fi
}

#######################################
# Build arguments for nextest E2E tests.
# Arguments:
#   Reference to an array for arguments
# Outputs:
#   None
#######################################
build_test_args() {
    local -n _main_ref_args=$1
    add_threading_args _main_ref_args
    add_filter_args _main_ref_args
    add_execution_args _main_ref_args
}

#######################################
# Execute E2E tests using nextest.
# Arguments:
#   Arguments for cargo nextest run
# Outputs:
#   Writes test results to stdout
#######################################
run_nextest() {
    echo "🧪 Running E2E tests..."
    cargo nextest run "$@"
}

#######################################
# Main entry point.
# Arguments:
#   $@
# Outputs:
#   None
#######################################
main() {
    local args=()
    build_test_args args
    run_nextest "${args[@]}"
    echo "✅ E2E tests complete"
}

main "$@"
