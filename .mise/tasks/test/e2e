#!/usr/bin/env bash
#
# e2e — Run end-to-end (E2E) tests using nextest.
#
#MISE description="Run end-to-end (E2E) tests using nextest"
#MISE alias="te"
#MISE depends=["fmt", "build"]
#MISE sources=["crates/cli/**/*.rs", "Cargo.toml"]
#MISE env={RUST_BACKTRACE="1"}
#USAGE flag "-v --verbose" help="Verbose output"
#USAGE arg "[filter]" help="Filter tests by name"

set -euo pipefail

# shellcheck disable=SC1091
source "$(git rev-parse --show-toplevel)/.mise/lib/_crate_names.sh"

#######################################
# Main entry point.
# Globals:
#   TEST_THREADS   (read)
#   usage_verbose  (read)
#   usage_filter   (read)
#######################################
main() {
  local -a args=()

  # Threading
  args+=("--test-threads" "${TEST_THREADS:-4}")

  # E2E filter: CLI crate smoke tests
  local cli_crate
  cli_crate="$(resolve_crate_name cli)"
  if [[ -z "${cli_crate}" ]]; then
    echo "Error: Could not resolve 'cli' crate" >&2
    exit 1
  fi

  args+=("--package" "${cli_crate}")
  args+=("--filter-expr" "binary(${cli_crate})")
  if [[ -n "${usage_filter:-}" ]]; then
    args+=("${usage_filter}")
  fi

  # Execution options
  args+=("--partition" "hash:1/1")
  if [[ "${usage_verbose:-}" == "1" ]]; then
    args+=("--verbose")
  fi

  echo "🧪 Running E2E tests..."
  cargo nextest run "${args[@]}"
  echo "✅ E2E tests complete"
}

main "$@"
