#!/usr/bin/env bash
#MISE description="Build all workspace crates"
#MISE alias="b"
#MISE depends=["fmt"]
#MISE sources=["**/*.rs", "Cargo.toml", "rustfmt.toml", "rust-toolchain.toml"]
#MISE outputs=["{{vars.target_dir}}/debug/{{vars.binary_name}}", "{{vars.target_dir}}/release/{{vars.binary_name}}"]
#USAGE flag "-r --release" help="Build in release mode"
#USAGE flag "-p --package <package>" help="Build a specific package" {
#USAGE   choices "core" "lithos-core" "cli" "lithos"
#USAGE }

set -euo pipefail

#######################################
# Map shorthand package names to full cargo package names.
# Globals:
#   usage_package
# Arguments:
#   None
# Outputs:
#   Echoes the full package name
#######################################
map_package_name() {
    case "${usage_package:-}" in
    core | lithos-core)
        echo "lithos-core"
        ;;
    cli | lithos)
        echo "lithos"
        ;;
    *)
        echo ""
        ;;
    esac
}

#######################################
# Build arguments for cargo build.
# Globals:
#   usage_release
# Arguments:
#   Reference to an array for arguments
#   The resolved package name
# Outputs:
#   None
#######################################
build_cargo_args() {
    local -n ref_args=$1
    local package_name=$2

    if [[ "${usage_release:-}" == "1" ]]; then
        ref_args+=("--release")
    fi

    if [[ -n "${package_name}" ]]; then
        ref_args+=("--package" "${package_name}")
    else
        ref_args+=("--workspace")
    fi
}

#######################################
# Run cargo build.
# Arguments:
#   Arguments for cargo build
# Outputs:
#   Writes build results to stdout
#######################################
run_cargo_build() {
    echo "🏗️  Building codebase..."
    cargo build "$@"
}

#######################################
# Main entry point.
# Globals:
#   None
# Arguments:
#   $@
# Outputs:
#   None
#######################################
main() {
    local resolved_package
    resolved_package=$(map_package_name)

    local args=()
    build_cargo_args args "${resolved_package}"

    run_cargo_build "${args[@]}"
    echo "✅ Build complete"
}

main "$@"
