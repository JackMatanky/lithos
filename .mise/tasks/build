#!/usr/bin/env bash
#MISE description="Build all workspace crates"
#MISE alias="b"
#MISE depends=["fmt"]
#MISE sources=["**/*.rs", "Cargo.toml", "rustfmt.toml", "rust-toolchain.toml"]
#MISE outputs=["{{vars.target_dir}}/debug/{{vars.binary_name}}"]
#USAGE flag "-r --release" help="Build in release mode"
#USAGE flag "-p --package <package>" help="Build a specific package" {
#USAGE   choices "core" "cli"
#USAGE }

set -euo pipefail

#######################################
# Map shorthand package names to full cargo package names.
# Globals:
#   usage_package  (read)
# Outputs:
#   Echoes the full package name (may be empty)
#######################################
map_package_name() {
  case "${usage_package:-}" in
    core)
      echo "lithos-core"
      ;;
    cli)
      echo "lithos"
      ;;
    *)
      echo ""
      ;;
  esac
}

#######################################
# Main entry point.
# Globals:
#   usage_release  (read)
#######################################
main() {
  local resolved_package
  resolved_package=$(map_package_name)

  local args=()
  if [[ "${usage_release:-}" == "1" ]]; then
    args+=("--release")
  fi

  if [[ -n "${resolved_package}" ]]; then
    args+=("--package" "${resolved_package}")
  else
    args+=("--workspace")
  fi

  echo "🏗️  Building codebase..."
  cargo build "${args[@]}"
  echo "✅ Build complete"
}

main "$@"
